{
  "name": "explorer-focus",
  "displayName": "Explorer Focus",
  "description": "A checkbox list in the Explorer to show/hide each git repository in a multi-repo workspace.",
  "version": "0.1.0",
  "publisher": "i585108",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "keywords": [
    "git",
    "multi-repo",
    "monorepo",
    "meta-repo",
    "explorer",
    "source control"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "views": {
      "explorer": [
        {
          "id": "explorerFocus.repos",
          "name": "Focused Repos",
          "icon": "$(repo)",
          "contextualTitle": "Focused Repos"
        }
      ]
    },
    "commands": [
      {
        "command": "explorerFocus.refresh",
        "title": "Explorer Focus: Refresh Repositories",
        "icon": "$(refresh)"
      },
      {
        "command": "explorerFocus.showAll",
        "title": "Explorer Focus: Show All Repositories",
        "icon": "$(eye)"
      },
      {
        "command": "explorerFocus.hideAll",
        "title": "Explorer Focus: Hide All Repositories",
        "icon": "$(eye-closed)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "explorerFocus.showAll",
          "when": "view == explorerFocus.repos",
          "group": "navigation@1"
        },
        {
          "command": "explorerFocus.hideAll",
          "when": "view == explorerFocus.repos",
          "group": "navigation@2"
        },
        {
          "command": "explorerFocus.refresh",
          "when": "view == explorerFocus.repos",
          "group": "navigation@3"
        }
      ]
    },
    "configuration": {
      "title": "Explorer Focus",
      "properties": {
        "explorerFocus.scanDepth": {
          "type": "number",
          "default": 2,
          "minimum": 1,
          "maximum": 4,
          "description": "How many directory levels below each workspace folder to search for git repositories."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.6.0"
  }
}
